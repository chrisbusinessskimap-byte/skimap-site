---
/* «Sito/Scheda comprensorio» (Figma 207:6423): foto del manifest con velo Abisso, nome, dove, numeri e credito sempre visibile.
   La foto è ritagliata (object-fit) e il credito lo dice (B6). Nessun logo del gestore (A14). */
import type { Lang } from '../i18n/langs';
import { areaPath } from '../i18n/routes';
import { type AreaView } from '../data/areas';
import { t } from '../content';

interface Props { lang: Lang; area: AreaView; loading?: 'eager' | 'lazy' }
const { lang, area, loading = 'lazy' } = Astro.props;
const c = t(lang);
const p = area.photo;
---
<article class="card" data-group={area.group}>
  <a class="link" href={areaPath(lang, area.slug)}>
    <img src={`${p.file}-s.webp`} srcset={`${p.file}-s.webp 640w, ${p.file}-l.webp 1600w`} sizes="(max-width: 640px) 90vw, 310px" width="640" height={Math.round(640 * p.height / p.width)} alt="" loading={loading} decoding="async" />
    <span class="veil" aria-hidden="true"></span>
    <span class="text">
      <span class="ts-sottotitolo name">{area.name}</span>
      <span class="stats">{area.km} km · {area.lifts} {c.areas.statLifts}</span>
      <span class="where">{c.areas.where[area.where]}</span>
    </span>
  </a>
  <p class="credit ts-credito">
    {c.ui.photoBy}: {p.author} · <a href={p.licenseUrl} rel="noopener">{p.license}</a> · <a href={p.sourceUrl} rel="noopener">Wikimedia Commons</a> · {c.ui.photoCrop}
  </p>
</article>

<style>
  .card { position: relative; border-radius: var(--radius-card); overflow: hidden; background: var(--brand-abisso); color: var(--brand-neve); min-height: 419px; display: flex; flex-direction: column; }
  .link { position: relative; display: block; flex: 1; min-height: 419px; text-decoration: none; }
  .link img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(11 20 48 / 0) 35%, rgb(11 20 48 / 0.94) 100%); }
  .text { position: absolute; left: 21px; right: 21px; bottom: 44px; display: grid; gap: 6px; }
  .name { font-size: 23px; letter-spacing: -0.005em; line-height: 1.2; }
  .stats { font-family: var(--font-mono); font-weight: 500; font-size: 14.6px; color: var(--brand-ghiaccio); line-height: 1.5; }
  .where { font-family: var(--font-mono); font-weight: 500; font-size: 11.5px; }
  .credit { position: absolute; left: 21px; right: 21px; bottom: 12px; color: rgb(255 255 255 / 0.82); font-size: 10.5px; line-height: 1.3; }
  .credit a { text-decoration: underline; }
  .link:hover .name { text-decoration: underline; }
  [hidden] { display: none !important; }
</style>
