---
/* I comprensori: i filtri (chip, «Sito/Chip filtro»), la mappa schematica fissa allo scorrimento e le schede. Il filtro è un'isola minuscola:
   senza JavaScript le chip non compaiono e si vedono tutti e otto. */
import type { Lang } from '../i18n/langs';
import { AREA_VIEWS, GROUPS } from '../data/areas';
import AreaCard from './AreaCard.astro';
import SchematicMap from './SchematicMap.astro';

interface Props { lang: Lang; filterLabel: string; all: string; groups: Record<string, string>; mapAria: string }
const { lang, filterLabel, all, groups, mapAria } = Astro.props;
---
<div class="browser">
  <div class="chips" role="group" aria-label={filterLabel} data-chips hidden>
    <button type="button" class="chip" data-group="all" aria-pressed="true">{all}</button>
    {GROUPS.map((g) => <button type="button" class="chip" id={g} data-group={g} aria-pressed="false">{groups[g]}</button>)}
  </div>
  <div class="body">
    <div class="mapcol"><div class="mappanel"><SchematicMap lang={lang} label={mapAria} /></div></div>
    <div class="cards" data-cards>
      {AREA_VIEWS.map((a) => <AreaCard lang={lang} area={a} />)}
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-chips]');
  if (root) {
    root.hidden = false;
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      pick(b.dataset.group!);
    });
    /* la zona scelta ingrandisce la cartina (evento «skimap:zone», vedi SchematicMap) e filtra le schede; l'indirizzo la ricorda (#dolomiti) e la home porta qui con lo stesso */
    const pick = (g: string, remember = true) => {
      const b = root.querySelector<HTMLButtonElement>(`button[data-group="${g}"]`);
      if (!b) return;
      root.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-cards] .card').forEach((c) => { c.hidden = g !== 'all' && c.dataset.group !== g; });
      document.dispatchEvent(new CustomEvent('skimap:zone', { detail: g }));
      if (remember) history.replaceState(null, '', g === 'all' ? location.pathname : `#${g}`);
    };
    const fromHash = () => { const g = location.hash.slice(1); if (g) pick(g, false); };
    setTimeout(fromHash, 0); // dopo lo script della cartina, che ascolta l’evento
    addEventListener('hashchange', fromHash);
  }
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .chip { padding: 9px 16px; border-radius: var(--radius-pill); border: 1px solid var(--color-line); background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); font-weight: 600; font-size: 15px; line-height: 1.3; min-height: 44px; }
  .chip[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .body { display: grid; grid-template-columns: minmax(300px, 540px) minmax(0, 640px); gap: 40px; align-items: start; }
  .mappanel { position: sticky; top: 110px; background: var(--color-soft); border-radius: 32px; padding: 20px; }
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 310px)); gap: 20px; }
  @media (max-width: 1023px) {
    .body { grid-template-columns: 1fr; }
    .mappanel { position: static; max-width: 560px; }
    .cards { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  }
</style>
