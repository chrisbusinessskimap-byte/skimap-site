---
/* La pagina di un comprensorio, chiara (Figma 226:6389 computer, 228:6541 telefono): lo stesso modello per tutti e otto (A12).
   I casi sono scritti: senza zone («un comprensorio solo»), senza giri (i giri sono sotto la linea di taglio), senza rilievo (qui la foto, non il rilievo),
   senza «come arrivare» (c'è un testo verificato solo per il Superski). Nessun logo del gestore; i numeri vengono dal manifest e si arrotondano per difetto. */
import Layout from '../layouts/Layout.astro';
import Phone from '../components/Phone.astro';
import { t, fill } from '../content';
import { bySlug, fmtTop } from '../data/areas';
import type { Lang } from '../i18n/langs';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const c = t(lang);
const a = c.area;
const area = bySlug(slug)!;
const p = area.photo;
const vars = { name: area.name, km: area.km, lifts: area.lifts, n: area.zoneCount };
const hasZones = !!area.zones && area.zones.length > 1;
const hasReach = area.id === 'superski';
/* dove ci sono collegamenti di bus e treni scritti nei dati (contratto, riga «bus-treni») */
const hasBus = ['superski', 'vialattea', 'livigno', 'skirama', 'monterosa'].includes(area.id);
const subnav = [
  ...(hasZones ? [{ id: 'zone', label: a.subnav.zones }] : []),
  { id: 'app', label: a.subnav.app },
  ...(hasReach ? [{ id: 'arrivare', label: a.subnav.reach }] : []),
];
---
<Layout lang={lang} page="areas" area={slug} title={fill(a.metaTitle, vars)} description={fill(a.metaDescription, vars)}>
  <section class="hero" aria-labelledby="h-area">
    <img class="bg" src={`${p.file}-m.webp`} srcset={`${p.file}-s.webp 480w, ${p.file}-m.webp 960w, ${p.file}-l.webp 1440w`} sizes="(max-width: 700px) 480px, 100vw" width="1440" height={Math.round(1440 * p.height / p.width)} alt="" fetchpriority="high" decoding="async" />
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap copy">
      <p class="eyebrow ts-occhiello">{c.areas.where[area.where]}</p>
      <h1 id="h-area" class="ts-display-m">{area.name}</h1>
      <dl class="stats">
        <div><dd class="ts-ora">{area.km}<small> km</small></dd><dt class="ts-credito">{a.km}</dt></div>
        <div><dd class="ts-ora">{area.lifts}</dd><dt class="ts-credito">{a.lifts}</dt></div>
        <div><dd class="ts-ora">{fmtTop(area.topM, lang)}</dd><dt class="ts-credito">{a.top}</dt></div>
        <div><dd class="ts-ora">{area.zoneCount}</dd><dt class="ts-credito">{a.zones}</dt></div>
      </dl>
      <p><a class="btn btn-primary" href={`/download/${area.id}`}>{a.download}</a></p>
      <p class="ts-credito credit">{c.ui.photoBy}: {p.author} · <a href={p.licenseUrl} rel="noopener">{p.license}</a> · <a href={p.sourceUrl} rel="noopener">Wikimedia Commons</a> · {c.ui.photoCrop}</p>
    </div>
  </section>

  <nav class="subnav" aria-label={area.name}>
    <div class="wrap ts-link">
      {subnav.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    </div>
  </nav>

  <div class="wrap body">
    {hasZones && (
      <section id="zone" aria-labelledby="h-zone">
        <h2 id="h-zone" class="ts-titolo">{fill(a.zonesTitle, vars)}</h2>
        <ol class="zones ts-testo">
          {area.zones!.map((z, i) => <li><span class="ts-ora-piccola">{String(i + 1).padStart(2, '0')}</span>{z}</li>)}
        </ol>
      </section>
    )}
    {!hasZones && <p class="ts-testo single">{a.zonesSingle}</p>}

    <section id="app" aria-labelledby="h-app" class="app">
      <div>
        <h2 id="h-app" class="ts-titolo">{a.appTitle}</h2>
        <ul class="ts-lead apps">
          <li set:html={hasZones ? fill(a.appPackZones, vars) : a.appPackSingle} />
          <li set:html={a.appReturn} />
          {hasBus && <li set:html={a.appBus} />}
        </ul>
      </div>
      <Phone screen="percorsi" alt={c.home.moments.items[0].alt} width={244} />
    </section>

    {hasReach && (
      <section id="arrivare" aria-labelledby="h-reach">
        <h2 id="h-reach" class="ts-titolo">{a.reachTitle}</h2>
        <div class="reach">
          {([a.reach.car, a.reach.train, a.reach.plane]).map(([k, v]) => <div><h3 class="ts-sottotitolo">{k}</h3><p class="ts-testo">{v}</p></div>)}
        </div>
      </section>
    )}
    <p class="ts-credito note"><span set:html={a.numbersNote} /> {a.notAffiliated}</p>
  </div>
</Layout>

<style>
  .hero { position: relative; min-height: 640px; display: flex; align-items: flex-end; overflow: hidden; background: var(--color-snow); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(246 249 253 / 0) 55%, rgb(246 249 253) 100%), linear-gradient(90deg, rgb(246 249 253 / 0.96) 0%, rgb(246 249 253 / 0.72) 55%, rgb(246 249 253 / 0.08) 100%); }
  .copy { position: relative; padding-block: 150px 56px; display: grid; gap: 22px; justify-items: start; }
  .stats { display: flex; flex-wrap: wrap; gap: 20px 44px; }
  .stats div { display: grid; gap: 4px; }
  .stats dd small { font-size: 0.5em; }
  .stats dt { color: var(--color-mute); order: 2; }
  .credit { color: var(--color-mute); }
  .subnav { position: sticky; top: 75px; z-index: 20; background: color-mix(in srgb, var(--color-snow) 92%, transparent); backdrop-filter: blur(10px); border-block: 1px solid var(--color-line); }
  .subnav .wrap { display: flex; gap: 32px; overflow-x: auto; }
  .subnav a { padding: 14px 0; text-decoration: none; white-space: nowrap; }
  .subnav a:hover { text-decoration: underline; }
  .body { display: grid; gap: 80px; padding-block: 72px 120px; }
  .zones { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 48px; margin-top: 24px; max-width: 760px; }
  .zones li { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-line); }
  .zones .ts-ora-piccola { color: var(--color-route); }
  .app { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; align-items: center; }
  .apps { display: grid; gap: 16px; margin-top: 20px; max-width: 560px; }
  .apps li { padding-left: 22px; position: relative; }
  .apps li::before { content: '—'; position: absolute; left: 0; color: var(--color-route); }
  .reach { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; margin-top: 24px; }
  .reach h3 { margin-bottom: 8px; }
  .note { color: var(--color-mute); max-width: 80ch; }
  @media (max-width: 1023px) {
    .hero { min-height: 560px; }
    .copy { padding-block: 120px 40px; }
    .subnav { top: 63px; }
    .body { gap: 56px; padding-block: 48px 72px; }
    .zones, .reach { grid-template-columns: 1fr; }
    .app { grid-template-columns: 1fr; }
  }
</style>
