---
/* La home, scura (Figma 221:6389 computer, 224:6389 telefono): apertura col rilievo e il selettore dell'ora, «una giornata, tre momenti»,
   i comprensori con la mappa schematica, e l'invito a scaricare. */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Phone from '../components/Phone.astro';
import StoreButton from '../components/StoreButton.astro';
import AreasBrowser from '../components/AreasBrowser.astro';
import { t } from '../content';
import { path } from '../i18n/routes';
import type { Lang } from '../i18n/langs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const h = c.home;
---
<Layout lang={lang} page="home" theme="notte" title={h.meta.title} description={h.meta.description} legacyHashes>
  <Hero lang={lang} alt={h.heroAlt}>
    <div class="copy">
      <p class="eyebrow ts-occhiello">{h.eyebrow}</p>
      <h1 class="ts-display-xl">{h.h1}</h1>
      <p class="lede ts-lead" set:html={h.lede} />
      <div class="cta">
        <StoreButton lang={lang} campaign="home" />
        <StoreButton lang={lang} campaign="home" kind="ios" />
      </div>
    </div>
    <div class="herophone">
      <Phone screen="guida" alt={h.phoneAlt} width={300} loading="eager" />
      <p class="ts-credito example">{c.ui.example}</p>
    </div>
  </Hero>

  <section class="moments" id="come-funziona" aria-labelledby="h-moments">
    <div class="wrap">
      <p class="eyebrow ts-occhiello">{h.moments.eyebrow}</p>
      <h2 id="h-moments" class="ts-display-m">{h.moments.h}</h2>
      <p class="ts-lead lede">{h.moments.lede}</p>
      <ol class="list">
        {h.moments.items.map((m) => (
          <li class="moment">
            <p class="time ts-ora-m">{m.time}</p>
            <h3 class="ts-titolo-m">{m.title}</h3>
            <p class="ts-testo" set:html={m.text} />
            <Phone screen={m.screen} alt={m.alt} width={250} />
          </li>
        ))}
      </ol>
      <p class="more"><a class="btn btn-ghost" href={path(lang, 'how')}>{c.ui.nav.how}</a></p>
    </div>
  </section>

  <section class="areas" id="comprensori" aria-labelledby="h-areas">
    <div class="wrap">
      <p class="eyebrow ts-occhiello">{h.areas.eyebrow}</p>
      <h2 id="h-areas" class="ts-display-m">{h.areas.h}</h2>
      <p class="ts-lead lede" set:html={h.areas.lede} />
      <AreasBrowser lang={lang} filterLabel={c.areas.filterLabel} all={h.areas.all} groups={h.areas.groups} mapAria={h.areas.mapAria} />
      <p class="more"><a class="btn btn-ghost" href={path(lang, 'areas')}>{c.ui.seeAll}</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="h-cta">
    <div class="wrap">
      <h2 id="h-cta" class="ts-titolo">{h.cta.h}</h2>
      <p class="ts-lead" set:html={h.cta.p} />
      <div class="cta"><StoreButton lang={lang} campaign="home-fondo" /><StoreButton lang={lang} campaign="home-fondo" kind="ios" /></div>
    </div>
  </section>
</Layout>

<style>
  .copy { max-width: 600px; display: grid; gap: 22px; }
  .eyebrow { color: var(--brand-ghiaccio); }
  .lede { color: color-mix(in srgb, var(--color-ink) 88%, transparent); max-width: 52ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .herophone { display: grid; justify-items: center; gap: 10px; }
  .example { color: rgb(255 255 255 / 0.8); }
  .moments, .areas { padding-block: 120px 40px; }
  .moments h2, .areas h2 { margin-block: 16px; max-width: 18ch; }
  .moments .lede, .areas .lede { max-width: 60ch; margin-bottom: 56px; }
  .list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  .moment { display: grid; gap: 14px; align-content: start; }
  .time { color: var(--brand-ghiaccio); }
  .moment :global(.phone) { margin-top: 18px; }
  .more { margin-top: 56px; }
  .band { margin-top: 120px; padding-block: 96px; background: var(--color-soft); }
  .band .wrap { display: grid; gap: 20px; justify-items: start; }
  .band h2 { max-width: 22ch; }
  @media (max-width: 1023px) {
    .moments, .areas { padding-block: 72px 24px; }
    .list { grid-template-columns: 1fr; gap: 56px; }
    .herophone { align-self: center; }
    .band { margin-top: 72px; padding-block: 64px; }
  }
</style>
